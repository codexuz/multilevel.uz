# ---------- Database (separate/local PostgreSQL) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multilevel
# Migrations run when the server starts. false = skip (run `npm run db:migrate` yourself).
DB_MIGRATE=true
# Only for a first deploy onto a database with another app's tables: drops them all.
DB_DROP_LEGACY_TABLES=false

# ---------- JWT auth ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32chars
# nuxt-auth-utils seals the OAuth state with this (>=32 chars)
NUXT_SESSION_PASSWORD=change-me-to-a-32-plus-character-secret-value

# ---------- Google OAuth ----------
# Redirect URI: <origin>/auth/google  (e.g. http://localhost:3000/auth/google)
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- Telegram sign-in (optional) ----------
# A bot from @BotFather; there, /setdomain the bot to your site's domain (multilevel.uz).
TELEGRAM_BOT_TOKEN=
# The server points the bot's updates at <site>/api/telegram/webhook on start (needs an https
# NUXT_PUBLIC_SITE_URL). Set to false if the bot's webhook is used by something else.
# TELEGRAM_WEBHOOK=true
# Optional: the bot's @username (otherwise asked of Telegram).
# TELEGRAM_BOT_USERNAME=

# ---------- Earning credits (open premium tests) ----------
# The channel to join for credits: its @username. The bot above must be an admin of it.
TELEGRAM_CHANNEL=
# What each is worth (defaults shown). A credit opens one premium test for good.
REWARD_REFERRER_CREDITS=2
REWARD_REFERRED_CREDITS=1
REWARD_TELEGRAM_CHANNEL_CREDITS=1
TEST_UNLOCK_CREDITS=1
# Most invites rewarded per inviter in 30 days.
REFERRAL_MONTHLY_CAP=30

# ---------- AI feedback on Writing and Speaking (optional) ----------
# An OpenAI API key turns on "Get AI feedback": an estimated score out of 75 and corrections.
OPENAI_API_KEY=
# Reviews per user: a month without Premium, a day with it (defaults shown).
AI_FEEDBACK_FREE_PER_MONTH=2
AI_FEEDBACK_PREMIUM_PER_DAY=10
# Optional: model and reasoning effort (defaults gpt-6-luna, medium; effort none..max).
# AI_FEEDBACK_MODEL=gpt-6-luna
# AI_FEEDBACK_EFFORT=medium
# AI feedback on Speaking also needs speech recognition: Deepgram (https://console.deepgram.com) or ElevenLabs.
DEEPGRAM_API_KEY=
# Optional: Deepgram model (default nova-3).
# DEEPGRAM_MODEL=nova-3
# ElevenLabs Scribe, instead of Deepgram or as its backup; TRANSCRIBER picks which goes first.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v2
# TRANSCRIBER=deepgram
# The examiner's voice in Speaking (OpenAI text-to-speech, kept in S3 once made).
# AI_TTS_MODEL=gpt-4o-mini-tts
# AI_TTS_VOICE=sage

# ---------- Promo codes ----------
# A promo code (made on /admin/promos) offered in the "Premium ends soon / has ended" messages.
# PREMIUM_RENEW_PROMO=BACK20

# ---------- Admins ----------
# These accounts become admins when they sign in (comma-separated). Telegram ids are numeric
# (ask @userinfobot); usernames are not used, as they can change hands.
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=

# ---------- AWS S3-compatible object storage ----------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=multilevel-uploads
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://multilevel-uploads.s3.amazonaws.com

# ---------- Selling plans ----------
# Click.uz merchant (SHOP API). Give Click these callback URLs:
#   Prepare:  <origin>/api/billing/click/prepare
#   Complete: <origin>/api/billing/click/complete
# Leave them empty to sell on Telegram instead: Buy opens NUXT_PUBLIC_SALES_TELEGRAM and an admin
# switches the plan on in Users → Grant.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
NUXT_PUBLIC_SALES_TELEGRAM=https://t.me/sizlidersizadmin2

# ---------- Public site metadata / social links ----------
NUXT_PUBLIC_SITE_URL=https://multilevel.uz
NUXT_PUBLIC_TELEGRAM_URL=https://t.me/sizlidersizadmin2
NUXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@multileveluz
# Set to false on staging deployments to emit noindex/nofollow.
NUXT_SITE_INDEXABLE=true

# ---------- Firebase Admin (server push send) ----------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Keep the literal \n escapes from the service-account JSON; the app un-escapes them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Firebase Web SDK (client FCM) ----------
NUXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NUXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NUXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key
