# Supabase (project already exists — paste keys from Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# AWS S3-compatible object storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=multilevel-uploads
S3_ACCESS_KEY_ID=YOUR-ACCESS-KEY
S3_SECRET_ACCESS_KEY=YOUR-SECRET-KEY
# Public base URL objects are served from (bucket public URL or CDN), no trailing slash
S3_PUBLIC_URL=https://multilevel-uploads.s3.amazonaws.com
